# =====================================================================
# repo 级 .gitignore —— 敏感信息防护
# 全局兜底层见 ~/.gitignore_global（对本机所有仓库生效），
# 内容级扫描见 .git/hooks/pre-commit（gitleaks + 密钥正则 + 隐私/路径三层）
# =====================================================================

# ===== 环境变量 / 本地密钥配置 =====
.env
.env.*
*.env
!.env.example
!.env.sample
!.env.template

# ===== 私钥与证书（公钥 *.pub 不拦，可正常提交）=====
*.key
*.pem
*.p12
*.pfx
*.keystore
*.ppk
id_rsa
id_ecdsa
id_ed25519
*.kdbx

# ===== 凭证类数据文件 =====
*credentials*.json
*credentials*.yaml
*credentials*.yml
*credentials*.toml
credentials*.ini
credentials*.conf
credentials*.properties
credentials*.csv
credentials*.txt
credentials*.env
.credentials
*.secrets
.secrets
.envrc
*.token
.netrc
.npmrc
.pypirc

# ===== 例外：示例模板文件允许提交（repo 内只提交 *.example 模板）=====
!*.example

# ===== 原始敏感数据目录（默认不入库，脱敏后的产出放外部）=====
data/

# ===== 运行时与缓存 =====
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/
node_modules/
.cache/

# ===== 日志 =====
*.log
logs/

# ===== 系统垃圾 =====
.DS_Store
Thumbs.db
desktop.ini

# ===== Rust 构建产物 =====
target/

# ===== 参考仓库（外部 clone，只读分析用）=====
repos/
